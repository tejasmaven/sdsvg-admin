# SDSVG Admin Panel — Apache Configuration

# PHP settings
php_value max_execution_time    120
php_value upload_max_filesize   12M
php_value post_max_size         14M

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block direct access to sensitive directories and files
<FilesMatch "^(config\.php|setup\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /sdsvg-admin/

    # Force HTTPS on production (comment out for local development)
    # RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP_HOST} !^localhost [NC]
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block access to sensitive directories
    RewriteRule ^(app|database|lib)(/|$) - [F,L]

    # Allow real files and directories to be served directly (CSS, JS, images)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else to the front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Deny access to hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
